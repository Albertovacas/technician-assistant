# Copy to .env and fill in. Never commit .env.

# LLM provider: "gemini" (Google AI Studio free tier) or "fake" (offline, deterministic; used in tests)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.1-flash-lite
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2
# Client-side throttle shared by all agents (Gemini free tier: 15 requests/min). 0 = off.
LLM_REQUESTS_PER_MINUTE=14
# Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Vector store. Empty QDRANT_URL = local embedded Qdrant in data/index/qdrant (no server).
# Set it (and QDRANT_API_KEY) to use a Qdrant server or Qdrant Cloud.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=manuals

# Embeddings (local ONNX via FastEmbed, downloaded once to data/.cache/fastembed)
EMBEDDING_MODEL=google/embeddinggemma-300m

# Reranking (local multilingual cross-encoder): search RERANK_CANDIDATES chunks, keep the
# best 5. Leave RERANK_MODEL empty to disable it (plain vector top-5).
RERANK_MODEL=jinaai/jina-reranker-v2-base-multilingual
RERANK_CANDIDATES=20

LOG_LEVEL=INFO
# text (human-readable) or json (one object per line, for Cloud Logging / log pipelines)
LOG_FORMAT=text
